# Copy to .env and fill in. Swap models by changing these lines only.
# Free options: groq (console.groq.com), gemini (aistudio.google.com), ollama (local).
LLM_PROVIDER=groq
LLM_API_KEY=
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_BASE_URL=   # only for LLM_PROVIDER=custom (any OpenAI-compatible endpoint)
# For "thinking" models (Gemini 2.5+/3.x): low|none, else answers can come back empty
# LLM_REASONING_EFFORT=low
# On a rate limit, try these models in order (same provider). Useful on free tiers.
# LLM_FALLBACK_MODELS=gemini-2.5-flash,gemini-3.1-flash-lite
# LLM_RETRIES=2
